---
// «A dónde va cada sol» (capa fluida): un diagrama de Sankey con un día de ventas de ejemplo,
// al estilo de los resultados que publican las empresas: lo que entra → la venta del día → se
// descuenta el IGV → se descuenta el costo → se descuentan gastos y planilla → lo que queda.
// La entrada se puede ver por sede o por medio de pago (las dos suman la misma venta).
//
// Los números son inventados pero cuadran al céntimo:
// - Las sedes son las del panel de la portada y suman su venta del día: S/ 4,320.50.
// - El IGV es el 18 % incluido en esa venta, calculado como en la herramienta: venta ÷ 1.18.
// - El costo de lo vendido es la mitad del valor de venta; gastos y planilla del día, S/ 644.
// El dibujo se calcula aquí, al armar el sitio: al visitante le llega un SVG fijo. El movimiento
// (dibujarse al aparecer, cambiar de vista, resaltar al tocar) lo pone fluido.js.

type Nodo = { id: string; nombre: string[]; valor: number; color: string; col: number; nota: string; vista?: string };
const soles = (c: number) => 'S/ ' + (c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// Montos en céntimos.
const sedes = [
  { id: 'centro', nombre: ['Sede Centro'], valor: 210590, color: '#1554E0' },
  { id: 'norte', nombre: ['Sede Norte'], valor: 128460, color: '#FF8F1F' },
  { id: 'sur', nombre: ['Sede Sur'], valor: 93000, color: '#2CB7F5' },
];
const medios = [
  { id: 'efectivo', nombre: ['Efectivo'], valor: 211460, color: '#14245E' },
  { id: 'yape', nombre: ['Yape y Plin'], valor: 150590, color: '#2E4A9A' },
  { id: 'tarjeta', nombre: ['Tarjeta'], valor: 70000, color: '#0A86C7' },
];
const total = sedes.reduce((s, x) => s + x.valor, 0); // 432050 (los medios suman lo mismo)
const valorVenta = Math.round(total / 1.18);
const igv = total - valorVenta;
const costo = Math.round(valorVenta * 0.5);
const margen = valorVenta - costo;
const gastos = 64400;
const queda = margen - gastos;
const pct = (c: number) => (Math.round(c / total * 1000) / 10).toString() + ' %';

const venta: Nodo = { id: 'venta', nombre: ['Venta del día'], valor: total, color: '#0B1841', col: 1, nota: 'Lo que pagaron los clientes, con el IGV incluido.' };
const nIgv: Nodo = { id: 'igv', nombre: ['IGV'], valor: igv, color: '#B05008', col: 2, nota: `Es el 18 % incluido en la venta (${soles(total)} − ${soles(total)} ÷ 1.18). No es suyo: se entrega a la SUNAT.` };
const nValor: Nodo = { id: 'valor', nombre: ['Valor de venta'], valor: valorVenta, color: '#1554E0', col: 2, nota: 'Lo que realmente vendió, sin el IGV.' };
const nCosto: Nodo = { id: 'costo', nombre: ['Costo de lo', 'vendido'], valor: costo, color: '#C4203F', col: 3, nota: 'Lo que costó la mercadería que salió hoy.' };
const nMargen: Nodo = { id: 'margen', nombre: ['Margen bruto'], valor: margen, color: '#0B6B41', col: 3, nota: 'Lo que deja la venta después de pagar la mercadería.' };
const nGastos: Nodo = { id: 'gastos', nombre: ['Gastos y', 'planilla'], valor: gastos, color: '#E0607A', col: 4, nota: 'Luz, movilidad, bolsas y la parte del día de la planilla.' };
const nQueda: Nodo = { id: 'queda', nombre: ['Queda para', 'el negocio'], valor: queda, color: '#12915A', col: 4, nota: 'Lo que queda después de todo.' };

// Dibujo.
const W = 1080, H = 470, ANCHO = 18, HUECO = 26, ARRIBA = 24, ABAJO = 24;
const X = [150, 345, 545, 735, 905];
const k = (H - ARRIBA - ABAJO - HUECO * 2) / total;
const centro = (ARRIBA + H - ABAJO) / 2;
type Pos = { x: number; y: number; h: number; sale: number; entra: number };
const pos: Record<string, Pos> = {};
const ubicar = (ns: { id: string; valor: number }[], col: number, medio: number, prefijo = '') => {
  const alto = ns.reduce((s, n) => s + n.valor * k, 0) + HUECO * (ns.length - 1);
  let y = medio - alto / 2;
  ns.forEach((n) => { pos[prefijo + n.id] = { x: X[col], y, h: n.valor * k, sale: y, entra: y }; y += n.valor * k + HUECO; });
};
ubicar(sedes, 0, centro, 's-');
ubicar(medios, 0, centro, 'm-');
ubicar([venta], 1, centro);
ubicar([nIgv, nValor], 2, centro);
ubicar([nCosto, nMargen], 3, pos.valor.y + pos.valor.h / 2);
ubicar([nGastos, nQueda], 4, pos.margen.y + pos.margen.h / 2);

const r1 = (n: number) => Math.round(n * 10) / 10;
const cinta = (de: string, a: string, valor: number) => {
  const p = pos[de], q = pos[a], g = valor * k;
  const x0 = p.x + ANCHO, x1 = q.x, xm = (x0 + x1) / 2;
  const y0 = p.sale, y1 = q.entra;
  p.sale += g; q.entra += g;
  return `M${r1(x0)} ${r1(y0)}C${r1(xm)} ${r1(y0)} ${r1(xm)} ${r1(y1)} ${r1(x1)} ${r1(y1)}L${r1(x1)} ${r1(y1 + g)}C${r1(xm)} ${r1(y1 + g)} ${r1(xm)} ${r1(y0 + g)} ${r1(x0)} ${r1(y0 + g)}Z`;
};
// La entrada, en sus dos vistas (cada una vuelve a llenar la barra de la venta desde arriba).
const entrada = (lista: typeof sedes, prefijo: string, vista: string) => {
  pos.venta.entra = pos.venta.y;
  return lista.map((n) => ({ d: cinta(prefijo + n.id, 'venta', n.valor), de: n.id, a: 'venta', color: n.color, vista, valor: n.valor }));
};
const cintasEntrada = [...entrada(sedes, 's-', 'sedes'), ...entrada(medios, 'm-', 'medios')];
const cintasSalida = [
  { d: cinta('venta', 'igv', igv), de: 'venta', a: 'igv', color: nIgv.color, valor: igv },
  { d: cinta('venta', 'valor', valorVenta), de: 'venta', a: 'valor', color: nValor.color, valor: valorVenta },
  { d: cinta('valor', 'costo', costo), de: 'valor', a: 'costo', color: nCosto.color, valor: costo },
  { d: cinta('valor', 'margen', margen), de: 'valor', a: 'margen', color: nMargen.color, valor: margen },
  { d: cinta('margen', 'gastos', gastos), de: 'margen', a: 'gastos', color: nGastos.color, valor: gastos },
  { d: cinta('margen', 'queda', queda), de: 'margen', a: 'queda', color: nQueda.color, valor: queda },
];
const fuentes: Nodo[] = [
  ...sedes.map((n) => ({ ...n, col: 0, vista: 'sedes', nota: 'Lo que vendió esta sede en el día.' })),
  ...medios.map((n) => ({ ...n, col: 0, vista: 'medios', nota: n.id === 'efectivo' ? 'Lo que entró al cajón.' : 'Lo que entró sin pasar por el cajón.' })),
];
const finales = [nIgv, nCosto, nGastos, nQueda];
const intermedios = [venta, nValor, nMargen];
const idDe = (n: Nodo) => (n.vista === 'sedes' ? 's-' : n.vista === 'medios' ? 'm-' : '') + n.id;
---
<section class="flujo solo-fluido" id="flujo" aria-labelledby="flujo-t">
  <div class="col">
    <div data-aparece>
      <p class="rotulo">A dónde va cada sol</p>
      <h2 class="titular titular--ancho" id="flujo-t">Un día del negocio, <span class="az">de la venta a lo que queda.</span></h2>
      <p class="flujo-baj">Primero sale el IGV, que es de la SUNAT. Después, lo que costó la mercadería. Después, los gastos y la planilla. Lo que queda es del negocio. Toque una parte para ver de dónde sale.</p>
    </div>

    <div class="flujo-caja" data-flujo>
      <div class="flujo-cab">
        <div class="flujo-seg" role="radiogroup" aria-label="Ver lo que entra">
          <span class="flujo-ficha" aria-hidden="true"></span>
          <input type="radio" name="flujo-vista" id="fv-sedes" value="sedes" checked><label for="fv-sedes">Por sede</label>
          <input type="radio" name="flujo-vista" id="fv-medios" value="medios"><label for="fv-medios">Por medio de pago</label>
        </div>
        <p class="flujo-pista" aria-hidden="true">Deslice para ver todo →</p>
      </div>
      <div class="flujo-desliza">
        <svg class="flujo-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="flujo-t flujo-desc" data-vista="sedes">
          <desc id="flujo-desc">Venta del día de ejemplo: {soles(total)}. Se descuenta el IGV ({soles(igv)}), el costo de lo vendido ({soles(costo)}) y los gastos y la planilla ({soles(gastos)}). Quedan {soles(queda)} para el negocio. Los montos están también en la tabla que sigue al diagrama.</desc>
          <g class="sk-cintas">
            {cintasEntrada.map((c) => (
              <path class={`sk-cinta sk-v-${c.vista}`} d={c.d} fill={c.color} data-de={c.de} data-a={c.a} data-valor={c.valor} />
            ))}
            {cintasSalida.map((c) => (
              <path class="sk-cinta" d={c.d} fill={c.color} data-de={c.de} data-a={c.a} data-valor={c.valor} />
            ))}
          </g>
          <g class="sk-nodos">
            {fuentes.map((n) => {
              const p = pos[idDe(n)];
              return (
                <g class={`sk-nodo sk-v-${n.vista}`} data-n={n.id} data-col="0" data-nombre={n.nombre.join(' ')} data-valor={n.valor} data-nota={n.nota} tabindex="0" role="button" aria-label={`${n.nombre.join(' ')}: ${soles(n.valor)}, el ${pct(n.valor)} de la venta del día`}>
                  <rect x={p.x} y={r1(p.y)} width={ANCHO} height={r1(p.h)} rx="5" fill={n.color} />
                  <text x={p.x - 14} y={r1(p.y + p.h / 2 - 4)} text-anchor="end" class="sk-nombre">{n.nombre[0]}</text>
                  <text x={p.x - 14} y={r1(p.y + p.h / 2 + 15)} text-anchor="end" class="sk-valor">{soles(n.valor)}</text>
                </g>
              );
            })}
            {intermedios.map((n) => {
              const p = pos[n.id];
              const cx = p.x + ANCHO / 2, cy = p.y + p.h / 2;
              const ancho = Math.max(n.nombre[0].length * 8.4, 92) + 28;
              return (
                <g class="sk-nodo sk-nodo--medio" data-n={n.id} data-col={n.col} data-nombre={n.nombre.join(' ')} data-valor={n.valor} data-nota={n.nota} tabindex="0" role="button" aria-label={`${n.nombre.join(' ')}: ${soles(n.valor)}, el ${pct(n.valor)} de la venta del día`}>
                  <rect x={p.x} y={r1(p.y)} width={ANCHO} height={r1(p.h)} rx="5" fill={n.color} />
                  <rect class="sk-chip" x={r1(cx - ancho / 2)} y={r1(cy - 25)} width={r1(ancho)} height="50" rx="14" />
                  <text x={cx} y={r1(cy - 4)} text-anchor="middle" class="sk-nombre">{n.nombre[0]}</text>
                  <text x={cx} y={r1(cy + 15)} text-anchor="middle" class="sk-valor">{soles(n.valor)}</text>
                </g>
              );
            })}
            {finales.map((n) => {
              const p = pos[n.id];
              const tx = p.x + ANCHO + 14, cy = p.y + p.h / 2;
              const lineas = n.nombre.length;
              const y0 = cy - (lineas * 18 + 18) / 2 + 14;
              return (
                <g class="sk-nodo" data-n={n.id} data-col={n.col} data-nombre={n.nombre.join(' ')} data-valor={n.valor} data-nota={n.nota} tabindex="0" role="button" aria-label={`${n.nombre.join(' ')}: ${soles(n.valor)}, el ${pct(n.valor)} de la venta del día`}>
                  <rect x={p.x} y={r1(p.y)} width={ANCHO} height={r1(p.h)} rx="5" fill={n.color} />
                  {n.nombre.map((l, i) => <text x={tx} y={r1(y0 + i * 18)} class="sk-nombre">{l}</text>)}
                  <text x={tx} y={r1(y0 + lineas * 18 + 1)} class="sk-valor">{soles(n.valor)} <tspan class="sk-pct">{pct(n.valor)}</tspan></text>
                </g>
              );
            })}
          </g>
        </svg>
      </div>
      <p class="flujo-info" data-flujo-info aria-live="polite">Venta del día: <b>{soles(total)}</b>. De cada S/ 100 que pagan los clientes, quedan <b>S/ {(Math.round(queda / total * 10000) / 100).toFixed(2)}</b> para el negocio.</p>
    </div>

    <div class="oculto">
      <table>
        <caption>Venta del día de ejemplo, de la venta a lo que queda</caption>
        <tbody>
          {[...fuentes, ...intermedios, ...finales].map((n) => <tr><th scope="row">{n.nombre.join(' ')}</th><td>{soles(n.valor)}</td><td>{pct(n.valor)}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="maqueta-rot maqueta-rot--claro">Ejemplo con datos inventados. Las sedes suman la venta del día del panel de la portada; el IGV es el 18 % incluido en esa venta.</p>
  </div>
</section>
