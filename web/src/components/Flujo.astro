---
// «A dónde va cada sol» (capa fluida): un diagrama de Sankey con un día de ventas de ejemplo.
// Tres columnas: sedes → medios de pago → a dónde va el dinero (IGV, costo, gastos y planilla, lo
// que queda). El ancho de cada cinta es proporcional al monto.
//
// Los números son inventados pero cuadran al céntimo:
// - Las sedes son las del panel de la portada y suman su venta del día: S/ 4,320.50.
// - El IGV es el 18 % incluido en esa venta, calculado como en la herramienta: venta ÷ 1.18.
// - Cada columna suma lo mismo. Las cintas del medio al destino se reparten en proporción.
// El dibujo se calcula aquí, al armar el sitio: al visitante le llegan dos SVG fijos (alargado para
// computadora, vertical para celular). El movimiento (aparecer en el sentido del recorrido,
// resaltar al pasar el mouse o tocar) lo pone fluido.js.

type Nodo = { id: string; nombre: string; valor: number; color: string; col: number };
// Montos en céntimos.
const sedes: Nodo[] = [
  { id: 'centro', nombre: 'Sede Centro', valor: 210590, color: '#1554E0', col: 0 },
  { id: 'norte', nombre: 'Sede Norte', valor: 128460, color: '#FF8F1F', col: 0 },
  { id: 'sur', nombre: 'Sede Sur', valor: 93000, color: '#2CB7F5', col: 0 },
];
const medios: Nodo[] = [
  { id: 'efectivo', nombre: 'Efectivo', valor: 0, color: '#14245E', col: 1 },
  { id: 'yape', nombre: 'Yape y Plin', valor: 0, color: '#2E4A9A', col: 1 },
  { id: 'tarjeta', nombre: 'Tarjeta', valor: 0, color: '#5B6785', col: 1 },
];
// Cuánto entró por cada medio en cada sede (cada fila suma la venta de su sede).
const porMedio: Record<string, Record<string, number>> = {
  centro: { efectivo: 98000, yape: 72590, tarjeta: 40000 },
  norte: { efectivo: 61460, yape: 47000, tarjeta: 20000 },
  sur: { efectivo: 52000, yape: 31000, tarjeta: 10000 },
};
medios.forEach((m) => { m.valor = sedes.reduce((s, x) => s + porMedio[x.id][m.id], 0); });
const total = sedes.reduce((s, x) => s + x.valor, 0); // 432050
const valorVenta = Math.round(total / 1.18);
const igv = total - valorVenta;
const costo = Math.round(valorVenta * 0.5);
const gastos = 64400;
const destinos: Nodo[] = [
  { id: 'igv', nombre: 'IGV (es de la SUNAT)', valor: igv, color: '#B05008', col: 2 },
  { id: 'costo', nombre: 'Costo de lo vendido', valor: costo, color: '#3A476B', col: 2 },
  { id: 'gastos', nombre: 'Gastos y planilla', valor: gastos, color: '#0A86C7', col: 2 },
  { id: 'queda', nombre: 'Queda para el negocio', valor: total - igv - costo - gastos, color: '#0B6B41', col: 2 },
];

// Cintas. Primera etapa: sede → medio. Segunda: medio → destino, en proporción; el último destino
// de cada medio se lleva el resto, para que cada medio reparta exactamente lo que recibió.
type Cinta = { de: Nodo; a: Nodo; valor: number };
const cintas: Cinta[] = [];
sedes.forEach((s) => medios.forEach((m) => cintas.push({ de: s, a: m, valor: porMedio[s.id][m.id] })));
medios.forEach((m) => {
  let usado = 0;
  destinos.forEach((d, i) => {
    const v = i === destinos.length - 1 ? m.valor - usado : Math.round(m.valor * d.valor / total);
    usado += v;
    cintas.push({ de: m, a: d, valor: v });
  });
});

// Dibujo. Se arma dos veces: alargado (de izquierda a derecha) para computadora y vertical (de
// arriba abajo) para celular; la hoja de estilos muestra uno u otro según el ancho de pantalla.
// «f» es el eje del recorrido (columna → columna) y «c» el eje transversal (donde se apilan).
type Forma = { pre: string; vert: boolean; W: number; H: number; F: number[]; T: number; gap: number; borde: number; fs: number };
const ALARGADO: Forma = { pre: 'h', vert: false, W: 1400, H: 440, F: [230, 690, 1110], T: 10, gap: 16, borde: 26, fs: 1.3 };
const VERTICAL: Forma = { pre: 'v', vert: true, W: 420, H: 0, F: [62, 322, 582], T: 12, gap: 14, borde: 14, fs: 1.2 };
// Nombres en dos líneas para el vertical, donde cada destino tiene poco ancho.
const corto: Record<string, string[]> = {
  igv: ['IGV'], costo: ['Costo de lo', 'vendido'], gastos: ['Gastos y', 'planilla'], queda: ['Queda para', 'el negocio'],
};
const columnas = [sedes, medios, destinos];
const nodos = [...sedes, ...medios, ...destinos];
const r1 = (n: number) => Math.round(n * 10) / 10;
const soles = (c: number) => 'S/ ' + (c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const pct = (c: number) => Math.round(c / total * 1000) / 10 + ' %';
// Ancho aproximado de un texto (para que las etiquetas del vertical no se monten).
const anchoNombre = (t: string, px: number) => t.length * px * 0.55;
const anchoValor = (t: string, px: number) => t.length * px * 0.61;
// Corre las etiquetas de una fila lo justo para que no se toquen ni se salgan del dibujo.
function separar(items: { x: number; w: number }[], W: number, margen = 10) {
  for (let i = 1; i < items.length; i++) {
    const min = items[i - 1].x + items[i - 1].w / 2 + margen + items[i].w / 2;
    if (items[i].x < min) items[i].x = min;
  }
  const ult = items[items.length - 1];
  if (ult.x + ult.w / 2 > W - 4) ult.x = W - 4 - ult.w / 2;
  for (let i = items.length - 2; i >= 0; i--) {
    const max = items[i + 1].x - items[i + 1].w / 2 - margen - items[i].w / 2;
    if (items[i].x > max) items[i].x = max;
  }
  if (items[0].x - items[0].w / 2 < 4) items[0].x = 4 + items[0].w / 2;
}

type Texto = { x: number; y: number; ancla: string; clase: string; s: string };
function armar(o: Forma) {
  const { vert, fs, T } = o;
  const L = vert ? o.W : o.H;
  const lo = vert ? o.borde : 46; // en el alargado, arriba van los títulos de columna
  const hi = L - o.borde;
  const k = Math.min(...columnas.map((c) => (hi - lo - o.gap * (c.length - 1)) / total));
  const pos: Record<string, { f: number; c: number; h: number; sale: number; entra: number }> = {};
  columnas.forEach((col, ci) => {
    const alto = col.reduce((s, n) => s + n.valor * k, 0) + o.gap * (col.length - 1);
    let c = (lo + hi) / 2 - alto / 2;
    col.forEach((n) => { pos[n.id] = { f: o.F[ci], c, h: n.valor * k, sale: c, entra: c }; c += n.valor * k + o.gap; });
  });
  const p = (f: number, c: number) => (vert ? `${r1(c)} ${r1(f)}` : `${r1(f)} ${r1(c)}`);
  const caminos = cintas.map((x, i) => {
    const a = pos[x.de.id], b = pos[x.a.id], g = x.valor * k;
    const f0 = a.f + T, f1 = b.f, fm = (f0 + f1) / 2, c0 = a.sale, c1 = b.entra;
    a.sale += g; b.entra += g;
    const d = `M${p(f0, c0)}C${p(fm, c0)} ${p(fm, c1)} ${p(f1, c1)}L${p(f1, c1 + g)}C${p(fm, c1 + g)} ${p(fm, c0 + g)} ${p(f0, c0 + g)}Z`;
    const grad = { x1: vert ? 0 : f0, x2: vert ? 0 : f1, y1: vert ? f0 : 0, y2: vert ? f1 : 0 };
    return { d, de: x.de.id, a: x.a.id, valor: x.valor, id: `sk-${o.pre}${i}`, grad, c1: x.de.color, c2: x.a.color };
  });

  const lh = 18 * fs;
  const piezas = nodos.map((n) => {
    const q = pos[n.id];
    const barra = vert ? { x: q.c, y: q.f, w: q.h, h: T } : { x: q.f, y: q.c, w: T, h: q.h };
    const cx = barra.x + barra.w / 2, cy = barra.y + barra.h / 2;
    const v = soles(n.valor);
    return { n, barra, cx, cy, v, textos: [] as Texto[], chip: null as null | { x: number; y: number; w: number; h: number } };
  });
  const de = (col: number) => piezas.filter((x) => x.n.col === col);

  // Columna del medio: queda encima de las cintas, así que su etiqueta va en una cápsula blanca
  // sobre la barra, para distinguirla de las cintas.
  const medio = de(1).map((x) => ({ x: x.cx, w: (vert ? Math.max(anchoNombre(x.n.nombre, 16 * fs), anchoValor(x.v, 13 * fs)) + 20 * fs : (Math.max(x.n.nombre.length * 8.6, 96) + 30) * fs) }));
  if (vert) separar(medio, o.W, 6);
  de(1).forEach((x, i) => {
    const m = medio[i];
    x.chip = { x: m.x - m.w / 2, y: x.cy - 26 * fs, w: m.w, h: 52 * fs };
    x.textos.push({ x: m.x, y: x.cy - 4 * fs, ancla: 'middle', clase: 'sk-nombre', s: x.n.nombre });
    x.textos.push({ x: m.x, y: x.cy + 16 * fs, ancla: 'middle', clase: 'sk-valor', s: x.v });
  });
  if (!vert) {
    // Alargado: sedes a la izquierda de su barra, destinos a la derecha.
    [0, 2].forEach((col) => de(col).forEach((x) => {
      const izq = col === 0;
      const tx = izq ? x.barra.x - 14 * fs : x.barra.x + T + 14 * fs;
      const ancla = izq ? 'end' : 'start';
      x.textos.push({ x: tx, y: x.cy - 3 * fs, ancla, clase: 'sk-nombre', s: x.n.nombre });
      x.textos.push({ x: tx, y: x.cy + 15 * fs, ancla, clase: 'sk-valor', s: x.v });
    }));
  } else {
    // Vertical: sedes encima de su barra; destinos debajo, en dos líneas.
    const arriba = de(0).map((x) => ({ x: x.cx, w: Math.max(anchoNombre(x.n.nombre, 15 * fs), anchoValor(x.v, 13 * fs)) }));
    separar(arriba, o.W);
    de(0).forEach((x, i) => {
      x.textos.push({ x: arriba[i].x, y: x.barra.y - 12 * fs - lh, ancla: 'middle', clase: 'sk-nombre', s: x.n.nombre });
      x.textos.push({ x: arriba[i].x, y: x.barra.y - 11 * fs, ancla: 'middle', clase: 'sk-valor', s: x.v });
    });
    const abajo = de(2).map((x) => ({ x: x.cx, w: Math.max(...corto[x.n.id].map((t) => anchoNombre(t, 15 * fs)), anchoValor(x.v, 13 * fs)) }));
    separar(abajo, o.W, 7);
    de(2).forEach((x, i) => {
      const y0 = x.barra.y + T + 22 * fs;
      corto[x.n.id].forEach((t, j) => x.textos.push({ x: abajo[i].x, y: y0 + j * lh, ancla: 'middle', clase: 'sk-nombre', s: t }));
      x.textos.push({ x: abajo[i].x, y: y0 + 2 * lh + 1, ancla: 'middle', clase: 'sk-valor', s: x.v });
    });
  }
  const titulos = vert ? [] : ['SEDES', 'MEDIO DE PAGO', 'A DÓNDE VA'].map((t, i) => ({ x: o.F[i] + T / 2, y: 20 * fs, s: t }));
  // Vertical: el alto sale del dibujo (etiquetas de arriba y de abajo incluidas).
  const caja = vert
    ? { y: r1(o.F[0] - 12 * fs - lh - 18 * fs), h: 0 }
    : { y: 0, h: o.H };
  if (vert) caja.h = r1(o.F[2] + T + 22 * fs + 2 * lh + 1 + 10 * fs - caja.y);
  return { o, caminos, piezas, titulos, caja };
}
const formas = [armar(ALARGADO), armar(VERTICAL)];
---
<section class="flujo solo-fluido" id="flujo" aria-labelledby="flujo-t">
  <div class="col">
    <div data-aparece>
      <p class="rotulo">A dónde va cada sol</p>
      <h2 class="titular titular--ancho" id="flujo-t">Un día del negocio, <span class="az">de la venta a las cuentas.</span></h2>
      <p class="flujo-baj">Cada venta entra por una sede y un medio de pago, y termina repartida: el IGV que es de la SUNAT, lo que costó la mercadería, los gastos y lo que queda para el negocio. Toque una parte para ver su camino.</p>
    </div>

    <div class="flujo-caja" data-flujo>
      {formas.map(({ o, caminos, piezas, titulos, caja }) => (
        <svg class={`flujo-svg flujo-svg--${o.pre}`} viewBox={`0 ${caja.y} ${o.W} ${caja.h}`} style={`--fs:${o.fs}`} role="img" aria-labelledby={`flujo-t flujo-desc-${o.pre}`}>
          <desc id={`flujo-desc-${o.pre}`}>Venta del día de ejemplo: {soles(total)}, repartida por sede, por medio de pago y por destino. Los montos están en la tabla que sigue al diagrama.</desc>
          <defs>
            {caminos.map((c) => (
              <linearGradient id={c.id} gradientUnits="userSpaceOnUse" x1={r1(c.grad.x1)} x2={r1(c.grad.x2)} y1={r1(c.grad.y1)} y2={r1(c.grad.y2)}>
                <stop offset="0" stop-color={c.c1} />
                <stop offset="1" stop-color={c.c2} />
              </linearGradient>
            ))}
          </defs>
          <g class="sk-cintas">
            {caminos.map((c) => (
              <path class="sk-cinta" d={c.d} fill={`url(#${c.id})`} data-de={c.de} data-a={c.a} data-valor={c.valor}>
                <title>{nodos.find((n) => n.id === c.de)!.nombre} → {nodos.find((n) => n.id === c.a)!.nombre}: {soles(c.valor)}</title>
              </path>
            ))}
          </g>
          <g class="sk-nodos">
            {piezas.map(({ n, barra, chip, textos }) => (
              <g class={n.col === 1 ? 'sk-nodo sk-nodo--medio' : 'sk-nodo'} data-n={n.id} data-col={n.col} data-nombre={n.nombre} data-valor={n.valor} tabindex="0" role="button" aria-label={`${n.nombre}: ${soles(n.valor)}, el ${pct(n.valor)} de la venta del día`}>
                <rect class="sk-barra" x={r1(barra.x)} y={r1(barra.y)} width={r1(barra.w)} height={r1(barra.h)} rx={o.T / 2 - 1} fill={n.color} />
                {chip && <rect class="sk-chip" x={r1(chip.x)} y={r1(chip.y)} width={r1(chip.w)} height={r1(chip.h)} rx={r1(16 * o.fs)} />}
                {textos.map((t) => <text x={r1(t.x)} y={r1(t.y)} text-anchor={t.ancla} class={t.clase}>{t.s}</text>)}
              </g>
            ))}
          </g>
          {titulos.length > 0 && (
            <g class="sk-titulos" aria-hidden="true">
              {titulos.map((t) => <text x={r1(t.x)} y={r1(t.y)} text-anchor="middle">{t.s}</text>)}
            </g>
          )}
        </svg>
      ))}
      <p class="flujo-info" data-flujo-info aria-live="polite">Venta del día: <b>{soles(total)}</b>. Toque una sede, un medio de pago o un destino.</p>
    </div>

    <div class="oculto">
    <table>
      <caption>Venta del día de ejemplo, por sede, medio de pago y destino</caption>
      <tbody>
        {nodos.map((n) => <tr><th scope="row">{n.nombre}</th><td>{soles(n.valor)}</td><td>{pct(n.valor)}</td></tr>)}
      </tbody>
    </table>
    </div>
    <p class="maqueta-rot maqueta-rot--claro">Ejemplo con datos inventados. Las sedes suman la venta del día del panel de la portada; el IGV es el 18 % incluido en esa venta.</p>
  </div>
</section>
