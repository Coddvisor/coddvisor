---
// Ilustración bajo el dato del 76.5 % (capa fluida): los registros sueltos de un negocio (cuaderno,
// Excel, WhatsApp, hojas de inventario...) son hilos que salen de los dos lados, cada uno a su
// tiempo, se tejen en el camino y terminan en «Un solo lugar», al centro.
// Aquí se arma el dibujo quieto (lo que ve quien pidió menos movimiento). fluido.js lo anima:
// cada hilo parte con su propio retraso, ondula al avanzar y se aparta un poco del mouse.
const N = 22;                    // hilos por lado
const W = 1000, H = 380;         // tamaño del dibujo
const cx = W / 2, cy = H / 2;    // centro: ahí se juntan
const X0 = 190;                  // donde nacen los hilos (y su espejo a la derecha)
const PASTILLA = 74;             // media anchura de «Un solo lugar»
const yDe = (i: number) => 22 + (i * (H - 44)) / (N - 1);
// Cada hilo llega a un costado de la pastilla, apenas separado de los demás.
const llegada = (y: number) => cy + (y - cy) * 0.05;
const curva = (x0: number, y: number, lado: 1 | -1) => {
  const ex = cx - lado * PASTILLA, ey = llegada(y);
  return `M${x0} ${y.toFixed(1)}C${x0 + lado * 230} ${y.toFixed(1)} ${ex - lado * 150} ${ey.toFixed(1)} ${ex} ${ey.toFixed(1)}`;
};
const hilos: { d: string; lado: 1 | -1; y: number }[] = [];
for (let i = 0; i < N; i++) {
  const y = yDe(i);
  hilos.push({ d: curva(X0, y, 1), lado: 1, y });
  hilos.push({ d: curva(W - X0, y, -1), lado: -1, y });
}
const sueltos = [
  { t: 'Cuaderno', y: 0 }, { t: 'Excel', y: 7 }, { t: 'WhatsApp', y: 14 }, { t: 'Calculadora', y: 21 },
];
const sueltosDer = [
  { t: 'Boletas en papel', y: 0 }, { t: 'Caja chica', y: 7 }, { t: 'Planilla a mano', y: 14 }, { t: 'Hojas de inventario', y: 21 },
];
---
<div class="hilos solo-fluido" aria-hidden="true" data-bucle data-hilos
  data-w={W} data-h={H} data-x0={X0} data-pastilla={PASTILLA}>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id="hilo-izq" gradientUnits="userSpaceOnUse" x1={X0} y1="0" x2={cx} y2="0">
        <stop offset="0" style="stop-color:var(--azul-real);stop-opacity:.55" />
        <stop offset=".7" style="stop-color:var(--celeste);stop-opacity:.75" />
        <stop offset="1" style="stop-color:var(--ambar)" />
      </linearGradient>
      <linearGradient id="hilo-der" gradientUnits="userSpaceOnUse" x1={W - X0} y1="0" x2={cx} y2="0">
        <stop offset="0" style="stop-color:var(--azul-real);stop-opacity:.55" />
        <stop offset=".7" style="stop-color:var(--celeste);stop-opacity:.75" />
        <stop offset="1" style="stop-color:var(--ambar)" />
      </linearGradient>
      <radialGradient id="hilo-brillo">
        <stop offset="0" style="stop-color:var(--ambar);stop-opacity:.35" />
        <stop offset="1" style="stop-color:var(--ambar);stop-opacity:0" />
      </radialGradient>
    </defs>
    <ellipse class="hilos-brillo" cx={cx} cy={cy} rx="230" ry="110" fill="url(#hilo-brillo)" />
    <g class="hilos-g" fill="none" stroke-width="1.2">
      {hilos.map((h) => <path d={h.d} stroke={h.lado === 1 ? 'url(#hilo-izq)' : 'url(#hilo-der)'} data-lado={h.lado} data-y={h.y.toFixed(1)} />)}
    </g>
    <g class="hilos-puntos">
      {hilos.map((h) => <circle cx={h.lado === 1 ? X0 : W - X0} cy={h.y.toFixed(1)} r="2.4" />)}
    </g>
    <g class="hilos-et">
      {sueltos.map((s) => <text x={X0 - 14} y={yDe(s.y) + 5} text-anchor="end">{s.t}</text>)}
      {sueltosDer.map((s) => <text x={W - X0 + 14} y={yDe(s.y) + 5}>{s.t}</text>)}
    </g>
    <g class="hilos-fin">
      <rect x={cx - PASTILLA} y={cy - 17} width={PASTILLA * 2} height="34" rx="17" />
      <text x={cx} y={cy + 5} text-anchor="middle">Un solo lugar</text>
    </g>
  </svg>
</div>
