---
// Herramienta gratis: vacaciones. La calculadora arriba y la guía debajo.
// Cuentas en public/herramientas/laboral.js (compartidas con gratificación, CTS y liquidación);
// esta página las usa desde public/herramientas/vacaciones.js.
// Truncas en la MYPE: sobre 15 días, con el criterio del MTPE (Boletín N.° 85) y su nota.
// Indemnización por vacaciones no tomadas en la MYPE: 15 + 15 días, criterio adoptado por Coddvisor, con nota.
// Diseño: el mismo de las herramientas nuevas (herramienta.css). La guía conserva TODO su texto.
import Base from '../../layouts/Base.astro';
import { llamado } from '../../datos/navegacion';
import { herramientas, autor, fechaLarga } from '../../datos/herramientas';

const h = herramientas.find((x) => x.href === '/herramientas/vacaciones/')!;
const ico = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
---
<Base
  titulo="Calculadora de vacaciones gratis: días y pago por régimen | Coddvisor"
  descripcion="Calcule cuántos días de vacaciones da y cuánto pagar según su régimen, las vacaciones truncas y las no tomadas a tiempo. Gratis y sin registrarse.">
<link slot="cabeza" rel="stylesheet" href="/herramientas/herramienta.css">

<section class="portada portada--interior osc" aria-labelledby="hv-t">
  <div class="brillo brillo--ambar" aria-hidden="true"></div>
  <div class="enmarcado interior-in">
    <span class="franja-sello" aria-hidden="true"></span>
    <p class="rotulo portada-rot">Herramienta gratis</p>
    <h1 class="portada-t interior-t" id="hv-t">Vacaciones de su equipo: <span class="cel">cuántos días y cuánto pagar.</span></h1>
    <p class="portada-baj">Con el sueldo de cada persona y su régimen. También si se va antes del año o si no las tomó a tiempo.</p>
    <ul class="confianza">
      <li set:html={ico + 'Gratis y sin registrarse'} />
      <li set:html={ico + 'Verificada contra la norma el ' + fechaLarga(h.verificada!)} />
      <li set:html={ico + 'Lo que escribe no sale de su computadora'} />
    </ul>
  </div>
</section>

<section class="her-sec" aria-label="Calculadora de vacaciones">
  <div class="col">
    <div class="lienzo">
      <form class="igv" id="vaca" autocomplete="off" novalidate>
        <div>
          <label class="igv-et" for="va-sueldo">Sueldo mensual</label>
          <div class="igv-monto"><span>S/</span><input id="va-sueldo" name="sueldo" type="text" inputmode="decimal" value="1500.00"></div>

          <div class="igv-grupo">
            <p class="igv-et" id="va-g-modo">¿Qué quiere calcular?</p>
            <div class="seg" role="radiogroup" aria-labelledby="va-g-modo">
              <span class="seg-ficha" aria-hidden="true"></span>
              <input type="radio" name="modo" id="va-anio" value="anio" checked><label for="va-anio">Del año</label>
              <input type="radio" name="modo" id="va-truncas" value="truncas"><label for="va-truncas">Se va</label>
              <input type="radio" name="modo" id="va-vencidas" value="vencidas"><label for="va-vencidas">No las tomó</label>
            </div>
            <p class="igv-ayuda">«Se va»: vacaciones truncas, para su liquidación. «No las tomó»: pasó el año siguiente sin descansar.</p>
          </div>

          <div class="igv-grupo">
            <p class="igv-et" id="va-g-reg">El régimen de su negocio</p>
            <div class="seg" role="radiogroup" aria-labelledby="va-g-reg">
              <span class="seg-ficha" aria-hidden="true"></span>
              <input type="radio" name="regimen" id="va-general" value="general" checked><label for="va-general">General</label>
              <input type="radio" name="regimen" id="va-pequena" value="pequena"><label for="va-pequena">Pequeña</label>
              <input type="radio" name="regimen" id="va-micro" value="micro"><label for="va-micro">Micro</label>
              <input type="radio" name="regimen" id="va-nose" value="nose"><label for="va-nose">No lo sé</label>
            </div>
            <p class="igv-ayuda">General: 30 días. Pequeña y micro inscritas en el REMYPE: 15 días. Si no está inscrito, elija General.</p>
          </div>

          <div class="igv-grupo">
            <p class="igv-et">La persona</p>
            <div class="caja-campos" data-modo="anio">
              <div class="campo"><label for="va-ingreso">Fecha de ingreso <small>(opcional)</small></label><input id="va-ingreso" name="ingreso" type="date"></div>
            </div>
            <div class="caja-campos" data-modo="truncas" hidden>
              <div class="campo"><label for="va-meses">Meses completos trabajados</label><input id="va-meses" name="meses" type="number" inputmode="numeric" min="0" max="11" step="1" value="7"></div>
              <div class="campo"><label for="va-dias">Días sueltos además</label><input id="va-dias" name="dias" type="number" inputmode="numeric" min="0" max="29" step="1" value="10"></div>
            </div>
            <label class="casilla"><input type="checkbox" name="horas4" checked> Trabaja 4 horas al día o más <small>(si no, le corresponden 6 días al año)</small></label>
            <label class="casilla" data-vende><input type="checkbox" name="vende"> Quiere vender 15 de sus 30 días <small>(por acuerdo escrito)</small></label>
          </div>
        </div>

        <div class="igv-res vaca-res" role="status" aria-live="polite">
          <p class="igv-et" data-r="et">Páguelo antes de que la persona salga de vacaciones</p>
          <p class="igv-grande" data-r="total">S/ 1,500.00</p>
          <p class="igv-frase" data-r="frase">30 días de descanso. Lleva los mismos descuentos que el sueldo (ONP o AFP, y renta).</p>
          <div data-uno>
            <div class="leyenda-rep">
              <div><span data-r="l-dias">Días</span><b data-r="dias">30 días</b></div>
              <div><span>Pago</span><b data-r="pago">S/ 1,500.00</b></div>
              <div data-fila="venta" hidden><span>Venta de 15 días</span><b></b></div>
              <div data-fila="gana" hidden><span>Cumple su año</span><b></b></div>
              <div data-fila="limite" hidden><span>Debe tomarlas antes del</span><b></b></div>
            </div>
            <div class="igv-cuenta" data-cuenta>
              <p class="igv-et">La cuenta, con sus números</p>
              <p class="igv-cuenta-l" data-r="cuenta">1,500.00 ÷ 30 × 30 = <span class="ce">1,500.00</span><br>Total: <span class="am">1,500.00</span></p>
              <a href="#g-calculo">Por qué se divide entre 30</a>
            </div>
            <p class="igv-ayuda" data-r="nota" hidden>Calculado con el criterio del Ministerio de Trabajo (Boletín Informativo Laboral N.° 85): dozavos de los 15 días. Si hay un reclamo, confírmelo con su contador.</p>
            <p class="igv-ayuda" data-r="nota-mype" hidden>Es la lectura más usada: 15 días por el descanso y 15 de indemnización. Una lectura literal del D. Leg. 713, art. 23 c), podría pedir un sueldo completo de indemnización. Si hay un reclamo, confírmelo con su contador.</p>
          </div>
          <div class="tres" data-tres hidden>
            <div><p class="tres-t">Régimen general</p><p class="tres-v" data-r="t-general">S/ 0.00</p><p class="tres-d" data-r="t-general-det"></p></div>
            <div><p class="tres-t">Pequeña empresa</p><p class="tres-v" data-r="t-pequena">S/ 0.00</p><p class="tres-d" data-r="t-pequena-det"></p></div>
            <div><p class="tres-t">Microempresa</p><p class="tres-v" data-r="t-micro">S/ 0.00</p><p class="tres-d" data-r="t-micro-det"></p></div>
          </div>
          <div class="igv-acc">
            <button type="button" class="boton-claro" data-copiar>Copiar resultado</button>
            <span class="igv-aviso" data-copiado role="status"></span>
          </div>
        </div>
      </form>
    </div>
  </div>
  <a class="barra-movil" href="#vaca" data-barra>Vacaciones a pagar <b data-barra-n>S/ 1,500.00</b></a>
</section>

<!-- Guía: el artículo del blog vive aquí, debajo de la herramienta. -->
<article class="guia guia-nueva" aria-labelledby="guia-t">
  <div class="col">
    <header class="guia-cab guia-in">
      <p class="rotulo">Guía · {h.categoria}</p>
      <h2 class="titular guia-t" id="guia-t">{h.guia}</h2>
      <p class="guia-meta">{autor} · <time datetime={h.publicada}>{fechaLarga(h.publicada)}</time> · {h.lectura} min de lectura</p>
    </header>

    <nav class="guia-indice" aria-label="En esta guía">
      <a href="#g-resumen" data-ind="g-resumen">En 30 segundos</a>
      <a href="#g-que" data-ind="g-que">Qué son</a>
      <a href="#g-pasos" data-ind="g-pasos">Paso a paso</a>
      <a href="#g-calculo" data-ind="g-calculo">Cómo se calcula</a>
      <a href="#g-dudas" data-ind="g-dudas">Dudas</a>
      <a href="#g-revisar" data-ind="g-revisar">Si no cuadra</a>
      <a href="#g-preguntas" data-ind="g-preguntas">Preguntas</a>
      <span class="leido" data-leido></span>
    </nav>

    <div class="resumen30 guia-sec" id="g-resumen">
      <b class="r">EN 30 SEGUNDOS</b>
      <p>En el régimen general, cada persona tiene 30 días de vacaciones pagadas por cada año completo de trabajo. En una micro o pequeña empresa inscrita en el REMYPE, son 15 días. El pago es el sueldo de esos días y se entrega antes de que la persona salga.</p>
    </div>

    <section class="guia-sec" id="g-que" aria-labelledby="g-que-t">
      <h3 class="guia-sec-t" id="g-que-t">Qué son las vacaciones</h3>
      <div class="guia-texto">
        <p>Son días de descanso pagados que la persona gana después de un año completo de trabajo. Se cuentan en días calendario, así que los domingos y feriados que caen en medio también cuentan. Deben tomarse dentro del año siguiente a aquel en que se ganaron.</p>
        <p>Para ganarlas, no basta con cumplir el año: hay que haber trabajado un mínimo de días. Son 260 días si la persona trabaja 6 días a la semana, o 210 si trabaja 5. El descanso médico, hasta 60 días al año, y las vacaciones del año anterior cuentan como días trabajados.</p>
      </div>
    </section>

    <section class="guia-sec" id="g-pasos" aria-labelledby="g-pasos-t">
      <h3 class="guia-sec-t" id="g-pasos-t">Paso a paso</h3>
      <div class="guia-pro">
        <ol class="pasos-pro" data-pasos>
          <li data-paso="0"><span class="n">PASO 1</span><h4>Confirme su régimen.</h4><p>Busque su RUC en la consulta del REMYPE. Si su negocio no está inscrito, da 30 días, aunque sea pequeño.</p></li>
          <li data-paso="1"><span class="n">PASO 2</span><h4>Revise la fecha de ingreso de cada persona.</h4><p>El derecho nace cuando cumple un año, no en enero. Anote en qué mes le toca a cada una.</p></li>
          <li data-paso="2"><span class="n">PASO 3</span><h4>Arme el rol de vacaciones del año.</h4><p>Acuerde las fechas con cada persona y póngalas por escrito. Cuide que no salgan a la vez todas las personas de una misma sede.</p></li>
          <li data-paso="3"><span class="n">PASO 4</span><h4>Pague antes de que salga.</h4><p>El pago es lo que la persona gana normalmente, incluidas las comisiones o los pagos que recibe con regularidad. Lleva los mismos descuentos y aportes que el sueldo: el seguro de salud (EsSalud en el régimen general y en la pequeña empresa; SIS en la microempresa, salvo que tenga EsSalud), ONP o AFP según el sistema de la persona, y la retención de renta de quinta.</p></li>
          <li data-paso="4"><span class="n">PASO 5</span><h4>Que las tome a tiempo.</h4><p>Si pasa el año siguiente sin descansar, usted debe pagar más, como se explica abajo.</p></li>
        </ol>
        <div class="escena">
          <p class="igv-et">La cuenta, paso a paso</p>
          <div class="ecu" aria-live="polite">
            <p class="ecu-l" data-l="0"><span>Régimen general</span> <small>30 días</small></p>
            <p class="ecu-l" data-l="1"><span>Entró el 10 de marzo de 2025</span> <small>cumple su año el 10 de marzo de 2026</small></p>
            <p class="ecu-l" data-l="2"><span>Rol: del 1 al 30 de julio</span> <small>por escrito</small></p>
            <p class="ecu-l" data-l="3">1,500.00 ÷ 30 × 30 = <span class="am">1,500.00</span> <small>antes de salir</small></p>
            <p class="ecu-l" data-l="4"><span class="ok">Tomadas antes del 10 de marzo de 2027 ✓</span></p>
          </div>
        </div>
      </div>
    </section>

    <section class="guia-sec" id="g-calculo" aria-labelledby="g-calculo-t">
      <h3 class="guia-sec-t" id="g-calculo-t">Cómo se calcula</h3>
      <div class="guia-texto">
        <div class="formula" aria-label="Fórmula">
          <p><b>Pago de vacaciones</b> = sueldo mensual ÷ 30 × días de vacaciones</p>
          <p><b>Vacaciones truncas</b> = sueldo ÷ 12 × meses trabajados + sueldo ÷ 360 × días sueltos</p>
        </div>
        <p style="margin-top:18px"><b>Un ejemplo.</b> Una persona gana S/ 1,500 y cumplió su año.</p>
        <ul class="guia-lista">
          <li><b>Régimen general:</b> 30 días, <b>S/ 1,500</b>.</li>
          <li><b>Pequeña o microempresa inscrita:</b> 15 días, S/ 1,500 ÷ 30 × 15 = <b>S/ 750</b>.</li>
        </ul>
        <p>Ponga el sueldo de cada persona en la calculadora de arriba y verá sus días y su pago.</p>
      </div>
    </section>

    <section class="guia-sec" id="g-dudas" aria-labelledby="g-dudas-t">
      <h3 class="guia-sec-t" id="g-dudas-t">Casos que generan dudas</h3>
      <div class="guia-texto">
        <p><b>Quiere vender sus vacaciones.</b> En el régimen general, la persona puede vender hasta 15 de sus 30 días, por acuerdo escrito. Con un sueldo de S/ 1,500, descansa 15 días pagados con S/ 750, trabaja los otros 15 y recibe S/ 750 más por esos días vendidos. Ese pago lleva los mismos descuentos y aportes que el sueldo.</p>
        <p><b>Quiere partirlas en pedazos.</b> En el régimen general, la persona puede pedir por escrito tomarlas por partes. Debe tomar 15 días seguidos, o un bloque de 7 y otro de 8, y el resto puede repartirlo en días sueltos.</p>
        <p>En una micro o pequeña empresa inscrita, si se parten las vacaciones, cada tramo debe ser de al menos 7 días. Con 15 días, en la práctica quedan 15 seguidos o un bloque de 7 y otro de 8.</p>
        <p>Otra cosa es reducir el descanso: se puede acordar por escrito bajarlo de 15 a 7 días, y por los 8 días que no descansa, la persona recibe una compensación de 8 días de sueldo. Con S/ 1,500, son S/ 750 de vacaciones más S/ 400 de compensación. La venta de días no funciona igual que en el régimen general, así que consúltela con su contador antes de firmar.</p>
        <p><b>No las tomó a tiempo.</b> Si pasa el año siguiente y la persona no descansó, usted debe un sueldo por el descanso no tomado y otro de indemnización. Con S/ 1,500, son <b>S/ 3,000</b> además del sueldo que ya le pagó por trabajar. Se calcula con el sueldo vigente el día del pago, y la indemnización no lleva aportes ni impuestos.</p>
        <p>En una micro o pequeña empresa inscrita, se deben 15 días de sueldo por el descanso no tomado y 15 días más de indemnización. Con S/ 1,500, son S/ 750 + S/ 750 = <b>S/ 1,500</b>. Aquí tampoco la indemnización lleva aportes ni impuestos.</p>
        <p><small>Es la lectura más usada. Una lectura literal del D. Leg. 713, art. 23 c), podría pedir una remuneración mensual completa como indemnización (S/ 750 + S/ 1,500 = S/ 2,250). Si hay un reclamo, confírmelo con su contador.</small></p>
        <p><b>Se va antes de cumplir el año.</b> Se le pagan las vacaciones <i>truncas</i> si trabajó al menos un mes. Si gana S/ 1,500 y se va con 7 meses y 10 días, recibe S/ 1,500 ÷ 12 × 7 = S/ 875 más S/ 1,500 ÷ 360 × 10 = S/ 41.67. Total: <b>S/ 916.67</b>, junto con su liquidación.</p>
        <p>En una micro o pequeña empresa, las truncas se pagan en dozavos y treintavos de lo que corresponde por un año, que en la MYPE es de 15 días (D. Leg. 713, art. 22; TUO MYPE, art. 55). Con el mismo sueldo y el mismo tiempo, son <b>S/ 458.33</b>. Así lo indica el Ministerio de Trabajo en su Boletín Informativo Laboral N.° 85; si hay un reclamo, confírmelo con su contador.</p>
      </div>
    </section>

    <section class="guia-sec" id="g-revisar" aria-labelledby="g-revisar-t">
      <h3 class="guia-sec-t" id="g-revisar-t">Si no cuadra, revise esto primero</h3>
      <ol class="errores" style="list-style:none;padding:0">
        <li class="error-c">
          <span class="n">1</span><h4>Dio 15 días sin estar inscrito en el REMYPE.</h4>
          <div class="error-par" aria-hidden="true"><p class="no">15 días sin inscripción</p><p class="si"><i>✓</i> 30 días</p></div>
          <p>Sin inscripción, corresponden 30. Haga la consulta por RUC antes de armar el rol.</p>
        </li>
        <li class="error-c">
          <span class="n">2</span><h4>Pagó al regreso.</h4>
          <p>Las vacaciones se pagan antes de que la persona salga. Inclúyalas en la planilla del mes en que descansa.</p>
        </li>
        <li class="error-c">
          <span class="n">3</span><h4>Dejó pasar el plazo.</h4>
          <p>Es lo que más caro sale. Anote en el rol la fecha límite de cada persona y revíselo cada mes.</p>
        </li>
        <li class="error-c">
          <span class="n">4</span><h4>Acordó todo de palabra.</h4>
          <p>La venta, el reparto y las fechas deben quedar por escrito y firmados. Sin papel, no hay cómo probar el acuerdo.</p>
        </li>
      </ol>
    </section>

    <section class="guia-sec" id="g-preguntas" aria-labelledby="g-preguntas-t">
      <h3 class="guia-sec-t" id="g-preguntas-t">Preguntas frecuentes</h3>
      <div class="faq guia-faq">
        <details><summary>¿Le tocan vacaciones a quien trabaja medio tiempo?<span class="mas" aria-hidden="true">+</span></summary><p>Depende de las horas. Si trabaja 4 horas diarias o más, le tocan los días completos de su régimen. Con menos de 4 horas al día, la ley peruana no le da esos días, pero la SUNAFIL y la Corte Suprema le reconocen al menos 6 días de descanso al año, por un convenio internacional que el Perú firmó.</p></details>
        <details><summary>¿Puedo adelantarle días antes de que cumpla el año?<span class="mas" aria-hidden="true">+</span></summary><p>Sí, por acuerdo escrito. Si luego se va, esos días se descuentan de sus vacaciones truncas, y lo que no alcance a cubrirse no se le cobra.</p></details>
        <details><summary>¿Quién decide la fecha?<span class="mas" aria-hidden="true">+</span></summary><p>Se fija de común acuerdo. Si no se ponen de acuerdo, decide el negocio, pero el reparto en partes solo puede pedirlo la persona.</p></details>
        <details><summary>¿Qué pasa si no doy vacaciones?<span class="mas" aria-hidden="true">+</span></summary><p>No darlas es una infracción muy grave ante la SUNAFIL, y no pagarlas a tiempo es grave. Además, se debe la indemnización por vacaciones no tomadas.</p></details>
      </div>

      <div class="verificada">
        <p><b>Verificada contra la norma el {fechaLarga(h.verificada!)}.</b> Revísela con su contador.</p>
        <ul>
          <li>Días, pago, venta, truncas y no tomadas: <a href="https://diariooficial.elperuano.pe/Normas/obtenerDocumento?idNorma=110007" rel="noopener" target="_blank">D. Leg. 713</a>, arts. 10 a 23, y su reglamento, D.S. 012-92-TR.</li>
          <li>Reparto por partes y venta: <a href="https://diariooficial.elperuano.pe/Normas/obtenerDocumento?idNorma=42" rel="noopener" target="_blank">D. Leg. 1405 y D.S. 002-2019-TR</a>.</li>
          <li>15 días en la micro y pequeña empresa: <a href="https://elperuano.pe/NormasElperuano/2013/12/28/1033071-5.html" rel="noopener" target="_blank">TUO de la Ley MYPE</a>, art. 55. Reducción a 7 días: D.S. 008-2008-TR, art. 37. Truncas sobre 15 días: <a href="https://cdn.www.gob.pe/uploads/document/file/289278/Art%C3%ADculo_REMYPE_-_Enero_2019.pdf" rel="noopener" target="_blank">Ministerio de Trabajo, Boletín Informativo Laboral N.° 85</a>.</li>
          <li>Medio tiempo, al menos 6 días: <a href="https://www.gob.pe/institucion/sunafil/noticias/1092181-cuando-te-corresponden-vacaciones-todo-lo-que-necesitas-saber-para-planificar-tu-descanso" rel="noopener" target="_blank">SUNAFIL, nota del 17 de enero de 2025</a> (Convenio 52 de la OIT); Tribunal de Fiscalización Laboral, Resolución 826-2023-SUNAFIL/TFL; Corte Suprema, <a href="https://elperuano.pe/noticia/287240-dictan-doctrina-jurisprudencial-sobre-descanso-vacacional-pagado" rel="noopener" target="_blank">Casación Laboral 35267-2023</a>.</li>
          <li>Aportes: <a href="https://orientacion.sunat.gob.pe/3094-principales-conceptos-afectos-al-aporte-al-snp-onp-personas" rel="noopener" target="_blank">SUNAT, conceptos afectos a ONP</a>. Infracciones: <a href="https://diariooficial.elperuano.pe/Normas/obtenerDocumento?idNorma=47" rel="noopener" target="_blank">D.S. 019-2006-TR</a>.</li>
        </ul>
      </div>
    </section>
  </div>
</article>

<section class="contacto osc" aria-labelledby="hv-cta-t">
  <div class="brillo brillo--contacto" aria-hidden="true"></div>
  <div class="enmarcado contacto-in contacto-in--simple">
    <div class="contacto-tx">
      <span class="franja-sello" aria-hidden="true"></span>
      <h2 class="titular titular--contacto" id="hv-cta-t">Cada integrante, <span class="cel">con su historia en un solo lugar.</span></h2>
      <p class="contacto-baj">Coddvisor arma la planilla con la asistencia de cada integrante, sede por sede. Lo que pasa cada día queda registrado.</p>
      <div class="portada-acc">
        <a class="btn" href={llamado.href}>{llamado.texto}</a>
