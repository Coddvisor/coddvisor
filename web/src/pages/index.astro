<section class="contacto osc" id="contacto" aria-labelledby="contacto-t">
  <div class="brillo brillo--contacto" aria-hidden="true"></div>
  <div class="enmarcado contacto-in">
    <div class="contacto-tx">
      <span class="franja-sello" aria-hidden="true"></span>
      <h2 class="titular titular--contacto" id="contacto-t">¿Quiere que su negocio <span class="cel">sea de los primeros?</span></h2>
      <p class="contacto-baj">Cuéntenos qué vende, cuántas personas trabajan con usted y cuántas sedes tiene. Le respondemos nosotros.</p>
      <div class="contacto-vias">
        <a data-wa data-wa-texto hidden href="/#contacto"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg><span>WhatsApp</span></a>
        <a href="mailto:equipo@coddvisor.com" data-correo-enlace><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg><span>equipo@coddvisor.com</span></a>
      </div>
    </div>

    <form class="form" data-form="contacto">
      <div class="campo">
        <label for="c-nombre">Su nombre</label>
        <input id="c-nombre" name="nombre" type="text" autocomplete="name" required>
      </div>
      <div class="campo">
        <label for="c-whatsapp">WhatsApp</label>
        <input id="c-whatsapp" name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" required>
      </div>
      <div class="campo campo--ancho">
        <label for="c-vende">¿Qué vende?</label>
        <input id="c-vende" name="vende" type="text" placeholder="Ej. ropa, calzado, abarrotes">
      </div>
      <!-- Opciones de un toque (antes, un menú desplegable): se ven todas y se eligen con un dedo. -->
      <fieldset class="campo campo--fichas" id="c-personas">
        <legend>Personas que trabajan</legend>
        <div class="fichas">
          <label class="ficha"><input type="radio" name="personas" value="1 a 5" checked><span>1 a 5</span></label>
          <label class="ficha"><input type="radio" name="personas" value="6 a 15"><span>6 a 15</span></label>
          <label class="ficha"><input type="radio" name="personas" value="16 a 40"><span>16 a 40</span></label>
        </div>
      </fieldset>
      <!-- Opciones de un toque (antes, un menú desplegable): se ven todas y se eligen con un dedo. -->
      <fieldset class="campo campo--fichas" id="c-sedes">
        <legend>Sedes</legend>
        <div class="fichas">
          <label class="ficha"><input type="radio" name="sedes" value="1" checked><span>1</span></label>
          <label class="ficha"><input type="radio" name="sedes" value="2 o 3"><span>2 o 3</span></label>
          <label class="ficha"><input type="radio" name="sedes" value="4 o más"><span>4 o más</span></label>
        </div>
      </fieldset>
      <!-- Campo trampa: las personas no lo ven; los robots que llenan todo, sí. -->
      <div class="trampa" aria-hidden="true">
        <label for="c-sitio">No llene este campo</label>
        <input id="c-sitio" name="sitio_web" type="text" tabindex="-1" autocomplete="off">
      </div>
      <button class="btn form-btn" type="submit">Quiero ser de los primeros</button>
      <p class="form-nota">Solo usamos estos datos para responderle. <a href="/privacidad/">Cómo los cuidamos</a>.</p>
      <p class="form-estado" data-estado="contacto" role="status"></p>
      <div class="form-respaldo" data-respaldo="contacto" hidden>
        <p>Si no se abrió nada, copie este mensaje y envíelo a <span data-respaldo-a></span>:</p>
        <textarea readonly rows="6" data-respaldo-texto aria-label="Mensaje listo para copiar"></textarea>
        <button class="btn-2 btn-2--claro" type="button" data-respaldo-copiar>Copiar mensaje</button>
      </div>
    </form>
  </div>
</section>

