---
// Portada. El molde (Base) pone el <head>, el menú y el pie; aquí va solo el contenido.
import Base from '../layouts/Base.astro';
// Piezas de la capa fluida: solo se ven con la clase fluido en <html> (ver LEEME, «La capa fluida»).
import Hilos from '../components/Hilos.astro';
import Modulos from '../components/Modulos.astro';
import Conectado from '../components/Conectado.astro';
import Flujo from '../components/Flujo.astro';
---
<Base
  titulo="Coddvisor: software de gestión para micro y pequeñas empresas del Perú"
  descripcion="Coddvisor reúne la venta, la caja, el inventario y la planilla en un solo lugar. Estamos empezando y buscamos los primeros negocios que quieran probarlo.">

<!-- 4.2 Portada -->
<section class="portada osc" id="inicio" aria-labelledby="portada-t">
  <div class="brillo brillo--ambar" aria-hidden="true"></div>
  <div class="brillo brillo--azul" aria-hidden="true"></div>
  <div class="enmarcado portada-in">
    <div class="portada-texto">
      <span class="franja-sello" aria-hidden="true"></span>
      <p class="rotulo portada-rot">Software de gestión para mypes del Perú</p>
      <h1 class="portada-t" id="portada-t">Vea <span class="cel">cada día</span> cómo le va a su negocio.</h1>
      <p class="portada-baj">Venta, caja, inventario y planilla en un solo lugar. <b>Lo que se vende descuenta el stock, entra a la caja y queda en las cuentas</b>, sede por sede.</p>
      <div class="portada-acc">
        <a class="btn" href="/#contacto">Quiero probarlo</a>
        <a class="btn-2" href="/#producto">Ver qué hace</a>
      </div>
      <ul class="confianza">
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Boletas y facturas electrónicas</li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Varias sedes y almacén</li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Funciona en el navegador</li>
      </ul>
    </div>

    <!-- 5. Panel «¿Cómo le va hoy?»: maqueta animada con datos inventados (sitio.js la mueve). -->
    <div class="portada-panel">
      <div class="panel" id="panel" aria-hidden="true">
        <div class="panel-barra">
          <span class="panel-ventana"><i></i><i></i><i></i><span>Resumen del día de todas las sedes</span></span>
          <span class="panel-ultima"><span class="vivo vivo--chico"></span><span class="panel-ultima-tx">Última venta: <span data-p="ultima">Blusa Emma talla M en Sede Centro, S/ 89.90</span></span></span>
        </div>
        <div class="panel-cuerpo">
          <div class="panel-fila">
            <div class="panel-veredicto">
              <span class="panel-et">¿CÓMO LE VA HOY?</span>
              <p class="panel-v" data-p="veredicto">Hoy va bien.</p>
              <p class="panel-linea" data-p="linea">Le faltan S/ 679.50 para la meta. Quedan tres cosas por resolver antes del cierre.</p>
              <div class="medidor">
                <div class="medidor-cab">
                  <span class="medidor-venta" data-p="venta">S/ 4,320.50</span>
                  <span class="medidor-pct"><span data-p="pct">86 %</span> DE LA META</span>
                </div>
                <div class="medidor-barra"><div class="medidor-resto" data-p="resto" style="width:14%"></div></div>
                <div class="medidor-ext"><span>S/ 0</span><span>Meta del día: S/ 5,000.00</span></div>
              </div>
            </div>

            <div class="sedes-caja">
              <div class="sedes">
                <div class="sedes-cab"><span>SEDE POR SEDE</span><span>VENTAS</span><span>CAJA</span><span>STOCK</span><span>EQUIPO</span></div>
                <div class="sedes-fila">
                  <span class="sede"><i class="hilo hilo--centro"></i>Sede Centro</span>
                  <span><span class="ver ver--ok">Va bien</span></span>
                  <span><span class="ver ver--ok">Cuadra</span></span>
                  <span><span class="ver ver--ok">Va bien</span></span>
                  <span><span class="ver ver--filo" data-celda="3" data-ok="Va bien">2 tarde</span></span>
                </div>
                <div class="sedes-fila">
                  <span class="sede"><i class="hilo hilo--norte"></i>Sede Norte</span>
                  <span><span class="ver ver--ok">Va bien</span></span>
                  <span><span class="ver ver--filo" data-celda="2" data-ok="Cuadra">Sin cerrar</span></span>
                  <span><span class="ver ver--actuar" data-celda="1" data-ok="Va bien">Falta XL</span></span>
                  <span><span class="ver ver--ok">Va bien</span></span>
                </div>
                <div class="sedes-fila">
                  <span class="sede"><i class="hilo hilo--sur"></i>Sede Sur</span>
                  <span><span class="ver ver--filo">Lenta</span></span>
                  <span><span class="ver ver--ok">Cuadra</span></span>
                  <span><span class="ver ver--ok">Va bien</span></span>
                  <span><span class="ver ver--ok">Va bien</span></span>
                </div>
                <div class="leyenda">
                  <span><i class="ley ley--ok"></i>Va bien</span>
                  <span><i class="ley ley--filo"></i>Al filo</span>
                  <span><i class="ley ley--actuar"></i>Hay que actuar</span>
                </div>
              </div>
            </div>
          </div>

          <div class="tareas">
            <div class="tareas-cab"><span class="tareas-t">Lo que toca hoy</span><span class="tareas-n" data-p="hechas">0 de 3 hecho</span></div>
            <ol class="tareas-lista">
              <li class="tarea" data-tarea="1"><span class="tarea-n">01</span><span class="tarea-tx">Bajar 1 casaca denim XL del almacén al piso</span><span class="tarea-sede">Sede Norte</span><span class="tarea-acc">Hacerlo</span></li>
              <li class="tarea" data-tarea="2"><span class="tarea-n">02</span><span class="tarea-tx">Cerrar la caja de la Sede Norte</span><span class="tarea-sede">Sede Norte</span><span class="tarea-acc">Ir a la caja</span></li>
              <li class="tarea" data-tarea="3"><span class="tarea-n">03</span><span class="tarea-tx">Revisar 2 marcaciones fuera de hora</span><span class="tarea-sede">Sede Centro</span><span class="tarea-acc">Revisar</span></li>
            </ol>
          </div>
        </div>
      </div>
      <p class="maqueta-rot">Maqueta con datos inventados; no es una captura.</p>
    </div>
  </div>
</section>

<!-- 4.4 Dato que abre -->
<section class="dato" aria-label="El problema">
  <div class="col dato-in" data-aparece>
    <p class="dato-num">76.5<span>%</span></p>
    <p class="dato-tx">de las micro y pequeñas empresas del Perú no lleva ningún registro de sus cuentas. Tres de cada cuatro no saben cómo les va.<sup class="ref"><a href="#fuente-1" aria-label="Fuente 1">1</a></sup></p>
  </div>
  <div class="col"><Hilos /></div>
</section>

<!-- 4.5 Tres beneficios -->
<section class="beneficios" aria-labelledby="beneficios-t">
  <div class="col">
    <h2 class="oculto" id="beneficios-t">Por qué Coddvisor</h2>
    <ul class="beneficios-lista">
      <li class="beneficio" data-aparece>
        <span class="icono icono--ambar"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg></span>
        <h3 class="beneficio-t beneficio-t--ambar">fácil de usar</h3>
        <p>Pensado para que cualquiera en la tienda lo use sin que nadie se lo explique.</p>
      </li>
      <li class="beneficio" data-aparece style="--d:.08s">
        <span class="icono icono--azul"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><path d="M8 12h8"/></svg></span>
        <h3 class="beneficio-t beneficio-t--azul">todo conectado</h3>
        <p>Una venta mueve el stock, la caja y las cuentas a la vez. Nadie pasa cifras a mano.</p>
      </li>
      <li class="beneficio" data-aparece style="--d:.16s">
        <span class="icono icono--verde"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></span>
        <h3 class="beneficio-t beneficio-t--verde">hecho en el Perú</h3>
        <p>Con boleta y factura electrónica, soles, Yape y Plin, y la planilla de la pequeña empresa.</p>
      </li>
    </ul>
  </div>
</section>

<!-- 4.6 Qué hace -->
<section class="producto" id="producto" aria-labelledby="producto-t">
  <div class="enmarcado producto-in">
    <div class="producto-cab" data-aparece>
      <p class="rotulo">Qué hace</p>
      <h2 class="titular titular--xl" id="producto-t">Tres partes del negocio, <span class="az">una sola fuente de verdad.</span></h2>
    </div>

    <div class="producto-cuerpo" id="producto-cuerpo">
      <div class="pestanas">
        <div class="pestana es-activa" id="vender">
          <h3><button class="pestana-b" type="button" aria-expanded="true" aria-controls="pestana-1"><span class="pestana-n">01</span>Venda y cuadre la caja</button></h3>
          <div class="pestana-det" id="pestana-1">
            <p>Venta en la tienda con comprobante electrónico, apertura y cierre de caja en cada sede.</p>
            <ul class="checks">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Boleta y factura electrónica</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Efectivo, Yape, Plin y tarjeta</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Cambios y devoluciones</li>
            </ul>
          </div>
          <div class="pestana-prog" aria-hidden="true"><span></span></div>
        </div>
        <div class="pestana" id="inventario">
          <h3><button class="pestana-b" type="button" aria-expanded="false" aria-controls="pestana-2"><span class="pestana-n">02</span>Controle el inventario de cada sede</button></h3>
          <div class="pestana-det" id="pestana-2">
            <p>Cuánto hay de cada producto, por talla y color, en el piso y en el almacén de cada sede.</p>
            <ul class="checks">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Por talla y color</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Piso y almacén de cada sede</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Traslados y conteos</li>
            </ul>
          </div>
          <div class="pestana-prog" aria-hidden="true"><span></span></div>
        </div>
        <div class="pestana" id="planilla">
          <h3><button class="pestana-b" type="button" aria-expanded="false" aria-controls="pestana-3"><span class="pestana-n">03</span>Marque asistencia y pague la planilla</button></h3>
          <div class="pestana-det" id="pestana-3">
            <p>Marcación con un código que cambia en la pantalla de la sede, sin huellas ni fotos del rostro.</p>
            <ul class="checks">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Tardanzas según su reglamento interno</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Planilla del régimen de la pequeña empresa</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Sin lectores de huella</li>
            </ul>
          </div>
          <div class="pestana-prog" aria-hidden="true"><span></span></div>
        </div>
        <a class="btn pestanas-btn" href="/#contacto">Quiero probarlo</a>
      </div>

      <div class="pantallas-caja">
        <!-- Pantallas de ejemplo: maquetas con datos inventados. -->
        <div class="pantallas" aria-hidden="true">
          <div class="pantalla" data-pantalla="0">
            <div class="pt">
              <div class="pt-cab"><span class="pt-tit">Vender</span><span class="chip">Sede Centro</span></div>
              <div class="pt-linea"><span>Blusa Emma, talla M</span><span>S/ 89.90</span></div>
              <div class="pt-linea"><span>Casaca denim, talla L</span><span>S/ 159.90</span></div>
              <div class="pt-linea pt-total"><span>Total</span><span>S/ 249.80</span></div>
              <div class="pt-metodos"><span class="sel">Yape</span><span>Plin</span><span>Efectivo</span><span>Tarjeta</span></div>
              <div class="pt-boton">Cobrar y emitir boleta</div>
              <div class="pt-ok"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Comprobante electrónico listo para enviar</div>
            </div>
            <!-- Aviso flotante (capa fluida): solo se ve con la clase fluido. Mismos datos de la maqueta. -->
            <span class="pt-flota pt-flota--abajo"><i class="pt-flota-ok"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></i>Boleta emitida por S/ 249.80</span>
          </div>
          <div class="pantalla" data-pantalla="1" hidden>
            <div class="pt pt--ancha">
              <div class="pt-cab"><span class="pt-tit">Casaca denim azul</span><span class="chip chip--ok">Al día</span></div>
              <div class="pt-tallas">
                <span></span><span class="t">S</span><span class="t">M</span><span class="t">L</span><span class="t">XL</span>
                <span class="r">En piso</span><span>3</span><span>5</span><span>4</span><span class="cero">0</span>
                <span class="r">Almacén</span><span>6</span><span>8</span><span>2</span><span>1</span>
                <span class="r">Otra sede</span><span>2</span><span>4</span><span>3</span><span>5</span>
              </div>
              <div class="pt-aviso"><span><b>XL:</b> no hay en piso.</span><span class="pt-aviso-b">Bajar 1 del almacén</span></div>
            </div>
            <span class="pt-flota pt-flota--arriba"><i class="pt-flota-info"></i>En otra sede quedan 5 XL</span>
          </div>
          <div class="pantalla" data-pantalla="2" hidden>
            <div class="pt-doble">
              <div class="pt-codigo">
                <span class="pt-codigo-et">CÓDIGO DE LA SEDE</span>
                <span class="pt-codigo-n">48 21</span>
                <span class="pt-codigo-tx">Cambia en la pantalla de la sede. Sin huellas ni fotos.</span>
              </div>
              <div class="pt-lista">
                <div><span>Ingreso 8:58</span><span class="ok">A tiempo</span></div>
                <div><span>Ingreso 9:01</span><span class="ok">A tiempo</span></div>
                <div><span>Ingreso 9:17</span><span class="mal">Tardanza</span></div>
                <div class="fin"><span>Planilla de noviembre</span><span>Lista</span></div>
              </div>
            </div>
            <span class="pt-flota pt-flota--abajo"><i class="pt-flota-ok"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></i>3 marcaciones hoy, 1 tardanza</span>
          </div>
        </div>
        <p class="maqueta-rot maqueta-rot--claro">Maqueta con datos inventados; no es una captura.</p>
      </div>
    </div>

    <div class="tambien">
      <p class="tambien-t">También lleva:</p>
      <ul class="tambien-lista">
        <li><span class="ico40"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/></svg></span>Gastos</li>
        <li><span class="ico40"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 22h18"/><path d="M6 18v-7"/><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="M12 2 20 7H4z"/></svg></span>Cuentas de dinero</li>
        <li><span class="ico40"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg></span>Estados financieros por sede</li>
        <li class="en-des"><span class="ico40"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg></span>Compras <span class="etq-des">EN DESARROLLO</span></li>
        <li class="en-des"><span class="ico40"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.12 15.88"/><path d="M14.47 14.48 20 20"/><path d="M8.12 8.12 12 12"/></svg></span>Producción en taller <span class="etq-des">EN DESARROLLO</span></li>
      </ul>
    </div>
  </div>
</section>

<!-- 4.7 Recorrido: cómo una venta mueve todo el negocio. Es la idea que une las partes del producto:
     se registra una vez y llega sola a donde tiene que llegar. Datos inventados. -->
<section class="recorrido" id="recorrido" aria-labelledby="recorrido-t">
  <div class="col">
    <div data-aparece>
      <p class="rotulo">Cómo una venta mueve todo el negocio</p>
      <h2 class="titular titular--ancho" id="recorrido-t">Se registra una vez. <span class="az">Llega sola a donde tiene que llegar.</span></h2>
    </div>
    <ol class="recorrido-pasos">
      <li class="rpaso" data-aparece>
        <span class="rpaso-n">01</span>
        <h3 class="rpaso-t">Se vende</h3>
        <div class="rpaso-dato" aria-hidden="true"><span>Blusa Emma, talla M</span><b>S/ 89.90</b></div>
        <p>La caja cobra con Yape y emite la boleta electrónica en el mismo momento.</p>
      </li>
      <li class="rpaso" data-aparece style="--d:.08s">
        <span class="rpaso-n">02</span>
        <h3 class="rpaso-t">Baja el stock</h3>
        <div class="rpaso-dato" aria-hidden="true"><span>Talla M en Sede Centro</span><b>5 → 4</b></div>
        <p>Se descuenta de esa talla, ese color y esa sede. Nadie lo anota en un cuaderno.</p>
      </li>
      <li class="rpaso" data-aparece style="--d:.16s">
        <span class="rpaso-n">03</span>
        <h3 class="rpaso-t">Entra a la caja</h3>
        <div class="rpaso-dato" aria-hidden="true"><span>Caja de Sede Centro, Yape</span><b>+ S/ 89.90</b></div>
        <p>Al cierre, la caja sabe cuánto debe haber en efectivo y cuánto en cada medio de pago.</p>
      </li>
      <li class="rpaso" data-aparece style="--d:.24s">
        <span class="rpaso-n">04</span>
        <h3 class="rpaso-t">Queda en las cuentas</h3>
        <div class="rpaso-dato" aria-hidden="true"><span>Ventas del mes, Sede Centro</span><b>Al día</b></div>
        <p>Los estados financieros de cada sede se arman con lo que ya pasó, sin pasar cifras a mano.</p>
      </li>
    </ol>
    <p class="maqueta-rot maqueta-rot--claro">Ejemplo con datos inventados.</p>
  </div>
</section>

