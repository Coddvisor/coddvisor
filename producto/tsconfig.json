{
  // Revisión de todo lo que no es paquetes/ (apps, módulos, plataforma,
  // herramientas) y de las pruebas, que sí corren en Node. paquetes/ además se
  // revisa sin Node con tsconfig.paquetes.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Cada capa tiene su prefijo. El de los módulos apunta solo a su puerta
    // (src/api.ts): por nombre no se puede llegar a lo interno de un módulo.
    "paths": {
      "@coddvisor/*": ["./paquetes/*/src/index.ts"],
      "@coddvisor-plataforma/*": ["./plataforma/*/src/index.ts"],
      // La firma tiene su propia entrada; ver plataforma/bd/src/index.ts.
      "@coddvisor-plataforma/bd/firma": ["./plataforma/bd/src/firma.ts"],
      // Escenarios inventados para las pruebas de los módulos.
      "@coddvisor-plataforma/bd/pruebas": ["./plataforma/bd/src/pruebas/escenario.ts"],
      "@coddvisor-modulo/*": ["./modulos/*/src/api.ts"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/src/**/*.mts",
    "paquetes/*/src/**/*.ts",
    "paquetes/*/src/**/*.mts",
    "modulos/*/src/**/*.ts",
    "modulos/*/src/**/*.mts",
    "plataforma/*/src/**/*.ts",
    "plataforma/*/src/**/*.mts",
    "herramientas/*/src/**/*.ts",
    "*.ts"
  ]
}
