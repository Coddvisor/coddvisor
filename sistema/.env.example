# Copie este archivo como .env.local y ponga su llave. .env.local no se sube a GitHub.
# La llave se crea en la Consola de Anthropic, una sola para Coddvisor, con límite de gasto.
ANTHROPIC_API_KEY=

# El servicio (aplicaciones/servicio/configuracion.ts). Sin estas variables no arranca.
# Los valores de verdad viven en la bóveda de la nube, nunca en el repositorio.
# Emisor de los pases: la dirección de Supabase Auth del proyecto (https://<ref>.supabase.co/auth/v1).
CODDVISOR_PASE_EMISOR=
# El origen público del panel, solo https y sin ruta (https://app.<dominio>).
# Todo pedido que cambia algo tiene que venir de aquí.
CODDVISOR_ORIGEN=
# Audiencia de los pases de quien entró.
CODDVISOR_PASE_AUDIENCIA=
# Juego de llaves públicas de Supabase (JWKS), en el mismo origen que el emisor.
CODDVISOR_PASE_LLAVES=
# La llave del portero: su número en portero.llave y su secreto en base64 (32 bytes o más).
CODDVISOR_PORTERO_LLAVE_NUMERO=
CODDVISOR_PORTERO_LLAVE_SECRETO=
