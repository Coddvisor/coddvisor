# Copie este archivo como .env.local y ponga su llave. .env.local no se sube a GitHub.
# La llave se crea en la Consola de Anthropic, una sola para Coddvisor, con límite de gasto.
ANTHROPIC_API_KEY=

# El servicio (aplicaciones/servicio/configuracion.ts). Sin estas variables no arranca.
# Los valores de verdad viven en la bóveda de la nube, nunca en el repositorio.
# Emisor de los pases: la dirección de Supabase Auth del proyecto (https://<ref>.supabase.co/auth/v1).
CODDVISOR_PASE_EMISOR=
# El origen público del panel, solo https y sin ruta (https://app.<dominio>).
# Todo pedido que cambia algo tiene que venir de aquí.
CODDVISOR_ORIGEN=
# Audiencia de los pases de quien entró.
CODDVISOR_PASE_AUDIENCIA=
# Juego de llaves públicas de Supabase (JWKS), en el mismo origen que el emisor.
CODDVISOR_PASE_LLAVES=
# La llave del portero: su número en portero.llave y su secreto en base64 (32 bytes o más).
CODDVISOR_PORTERO_LLAVE_NUMERO=
CODDVISOR_PORTERO_LLAVE_SECRETO=
# Supabase Auth del proyecto: la dirección de su API (https://<ref>.supabase.co/auth/v1),
# en el mismo origen que el emisor, y la clave pública del proyecto (la «publishable»
# o la «anon»). NUNCA la llave de servicio (service_role o sb_secret_...): el servicio
# que atiende pedidos no la tiene (decisión 10 de identidad).
CODDVISOR_CUENTAS_DIRECCION=
CODDVISOR_CUENTAS_CLAVE_PUBLICA=
# La base: el repartidor de Supabase en modo transacción (puerto 6543), con el rol
# coddvisor_entrada.<ref del proyecto> y su contraseña, y sslmode=verify-full o require.
# NUNCA el usuario postgres ni la SUPABASE_DB_URL que Supabase pone sola en la función.
# postgresql://coddvisor_entrada.<ref>:<contraseña>@<servidor del repartidor>:6543/postgres?sslmode=verify-full
CODDVISOR_BASE_DIRECCION=
# Opcional: el certificado raíz de la base en PEM, si verify-full no reconoce el del
# repartidor con los certificados del sistema. Se descarga en Database Settings →
# SSL Configuration. No es un secreto. Exige sslmode=verify-full. En una sola línea,
# los saltos se pueden escribir como \n. Bajar a sslmode=require es el último recurso.
CODDVISOR_BASE_CERTIFICADO=
